<Window x:Class="HabitTracker1.Views.AddHabitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить привычку" 
        Height="600" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Создание новой привычки" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <!-- Название привычки -->
        <TextBlock Grid.Row="1" Text="Название привычки:" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" 
                 x:Name="NameTextBox"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 Margin="0,0,0,15"/>

        <!-- Категория -->
        <TextBlock Grid.Row="3" Text="Категория:" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4"
                  x:Name="CategoryComboBox"
                  Padding="10"
                  Height="35"
                  Background="White"
                  BorderBrush="#BDC3C7"
                  BorderThickness="1"
                  Margin="0,0,0,15"/>

        <!-- Частота -->
        <TextBlock Grid.Row="5" Text="Частота выполнения:" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="6"
                  x:Name="FrequencyComboBox"
                  Padding="10"
                  Height="35"
                  Background="White"
                  BorderBrush="#BDC3C7"
                  BorderThickness="1"
                  Margin="0,0,0,15">
            <ComboBoxItem Content="Ежедневно" Tag="Daily"/>
            <ComboBoxItem Content="По будням" Tag="Weekdays"/>
            <ComboBoxItem Content="Раз в неделю" Tag="Weekly"/>
        </ComboBox>

        <!-- Единица измерения -->
        <TextBlock Grid.Row="7" Text="Единица измерения (опционально):" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="8"
                 x:Name="UnitTextBox"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 Foreground="#95A5A6"
                 Text="минуты, км, страницы"
                 Margin="0,0,0,15"/>

        <!-- Целевое значение -->
        <TextBlock Grid.Row="9" Text="Целевое значение (опционально):" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="10"
                 x:Name="TargetValueTextBox"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 Foreground="#95A5A6"
                 Text="30"
                 Margin="0,0,0,15"/>

        <!-- Время напоминания -->
        <TextBlock Grid.Row="11" Text="Время напоминания (опционально):" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="12"
                 x:Name="ReminderTimeTextBox"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 Foreground="#95A5A6"
                 Text="HH:mm"/>

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="13"
                   x:Name="ErrorMessage"
                   Foreground="#E74C3C"
                   TextWrapping="Wrap"
                   MinHeight="20"
                   Margin="0,10,0,0"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Создать" 
                    Background="#27AE60" 
                    Foreground="White" 
                    Padding="20,10" 
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="CreateButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Отмена" 
                    Background="#95A5A6" 
                    Foreground="White" 
                    Padding="20,10" 
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
