<Window x:Class="HabitTracker1.Views.AddHabitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить привычку" 
        Height="500" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Создание новой привычки" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <!-- Название привычки -->
        <TextBlock Grid.Row="1" Text="Название привычки:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" 
                 x:Name="NameTextBox"
                 Margin="0,20,0,0"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 Grid.RowSpan="1"/>

        <!-- Категория -->
        <TextBlock Grid.Row="2" Text="Категория:" Margin="0,15,0,5"/>
        <ComboBox Grid.Row="2"
                  x:Name="CategoryComboBox"
                  Margin="0,20,0,0"
                  Padding="10"
                  Height="35"
                  Background="White"
                  BorderBrush="#BDC3C7"
                  BorderThickness="1"/>

        <!-- Частота -->
        <TextBlock Grid.Row="3" Text="Частота выполнения:" Margin="0,15,0,5"/>
        <ComboBox Grid.Row="3"
                  x:Name="FrequencyComboBox"
                  Margin="0,20,0,0"
                  Padding="10"
                  Height="35"
                  Background="White"
                  BorderBrush="#BDC3C7"
                  BorderThickness="1">
            <ComboBoxItem Content="Ежедневно" Tag="Daily"/>
            <ComboBoxItem Content="По будням" Tag="Weekdays"/>
            <ComboBoxItem Content="Раз в неделю" Tag="Weekly"/>
        </ComboBox>

        <!-- Единица измерения -->
        <TextBlock Grid.Row="4" Text="Единица измерения (опционально):" Margin="0,15,0,5"/>
        <TextBox Grid.Row="4"
                 x:Name="UnitTextBox"
                 Margin="0,20,0,0"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 Text="минуты, км, страницы"/>

        <!-- Целевое значение -->
        <TextBlock Grid.Row="5" Text="Целевое значение (опционально):" Margin="0,15,0,5"/>
        <TextBox Grid.Row="5"
                 x:Name="TargetValueTextBox"
                 Margin="0,20,0,0"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 Text="30"/>

        <!-- Время напоминания -->
        <TextBlock Grid.Row="6" Text="Время напоминания (опционально):" Margin="0,15,0,5"/>
        <TextBox Grid.Row="6"
                 x:Name="ReminderTimeTextBox"
                 Margin="0,20,0,0"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 Text="HH:mm"/>

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="7"
                   x:Name="ErrorMessage"
                   Foreground="#E74C3C"
                   TextWrapping="Wrap"
                   Margin="0,15,0,0"
                   MinHeight="20"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Создать" 
                    Background="#27AE60" 
                    Foreground="White" 
                    Padding="20,10" 
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="CreateButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Отмена" 
                    Background="#95A5A6" 
                    Foreground="White" 
                    Padding="20,10" 
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
