<Window x:Class="HabitTracker1.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" 
        Height="537" 
        Width="448"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border CornerRadius="10" Background="White" BorderBrush="#2C3E50" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8,8,0,0">
                <TextBlock Text="Создание аккаунта" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Содержимое -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="30,30" VerticalAlignment="Top">
                    <!-- Имя пользователя -->
                    <TextBlock Text="Имя пользователя:" 
                               Margin="0,0,0,8"
                               Foreground="#34495E"/>
                    <TextBox x:Name="UsernameTextBox" 
                             Padding="10"
                             Height="35"
                             Margin="0,0,0,15"
                             FontSize="12"
                             Background="#ECF0F1"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"/>

                    <!-- Email -->
                    <TextBlock Text="Email (опционально):" 
                               Margin="0,0,0,8"
                               Foreground="#34495E"/>
                    <TextBox x:Name="EmailTextBox" 
                             Padding="10"
                             Height="35"
                             Margin="0,0,0,15"
                             FontSize="12"
                             Background="#ECF0F1"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"/>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль (минимум 6 символов):" 
                               Margin="0,0,0,8"
                               Foreground="#34495E"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Padding="10"
                                 Height="35"
                                 Margin="0,0,0,15"
                                 FontSize="12"
                                 Background="#ECF0F1"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"/>

                    <!-- Подтверждение пароля -->
                    <TextBlock Text="Подтверждение пароля:" 
                               Margin="0,0,0,8"
                               Foreground="#34495E"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" 
                                 Padding="10"
                                 Height="35"
                                 Margin="0,0,0,10"
                                 FontSize="12"
                                 Background="#ECF0F1"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"/>

                    <!-- Сообщение об ошибке -->
                    <TextBlock x:Name="ErrorMessage" 
                               Foreground="#E74C3C" 
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"
                               MinHeight="30"/>

                    <!-- Кнопки -->
                    <Button x:Name="RegisterButton" 
                            Content="Зарегистрироваться" 
                            Height="40" 
                            Background="#27AE60" 
                            Foreground="White" 
                            FontSize="14" 
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="RegisterButton_Click"
                            Margin="0,0,0,10"/>

                    <Button x:Name="CancelButton" 
                            Content="Отмена" 
                            Height="40" 
                            Background="#95A5A6" 
                            Foreground="White" 
                            FontSize="14" 
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
