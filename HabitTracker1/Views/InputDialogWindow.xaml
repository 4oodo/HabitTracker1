<Window x:Class="HabitTracker1.Views.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод данных" 
        Height="220" 
        Width="500"
        MinWidth="400"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock" 
                   Text="Введите данные" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"
                   Margin="0,0,0,15"/>

        <TextBlock x:Name="MessageTextBlock" 
                   Grid.Row="1"
                   Text="Сообщение" 
                   FontSize="12" 
                   Foreground="#7F8C8D"
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="2"
                 x:Name="InputTextBox"
                 Padding="10"
                 Height="35"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" 
                    Background="#27AE60" 
                    Foreground="White" 
                    Padding="20,10" 
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="OkButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Отмена" 
                    Background="#95A5A6" 
                    Foreground="White" 
                    Padding="20,10" 
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
