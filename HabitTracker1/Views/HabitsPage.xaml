<Page x:Class="HabitTracker1.Views.HabitsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои привычки"
      Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопка добавления привычки -->
        <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Добавить привычку" 
                        Background="#27AE60" 
                        Foreground="White" 
                        Padding="15,10" 
                        FontSize="12" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="AddHabitButton_Click"/>
                <Button Content="Обновить" 
                        Background="#3498DB" 
                        Foreground="White" 
                        Padding="15,10" 
                        FontSize="12" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="10,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Список привычек -->
        <ListBox Grid.Row="1" 
                 x:Name="HabitsListBox"
                 Background="#F5F5F5"
                 BorderThickness="0"
                 ItemsSource="{Binding Habits}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" 
                            Margin="10" 
                            Padding="15" 
                            CornerRadius="5"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Text="{Binding Category.Name, StringFormat='Категория: {0}'}" 
                                       FontSize="12"
                                       Foreground="#7F8C8D"
                                       Margin="0,5,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="{Binding Frequency, StringFormat='Частота: {0}'}" 
                                       FontSize="12"
                                       Foreground="#7F8C8D"
                                       Margin="0,3,0,0"/>

                            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Отметить" 
                                        Background="#27AE60" 
                                        Foreground="White" 
                                        Padding="10,5" 
                                        FontSize="11"
                                        Margin="10,0"
                                        Cursor="Hand"/>
                                <Button Content="Изменить" 
                                        Background="#3498DB" 
                                        Foreground="White" 
                                        Padding="10,5" 
                                        FontSize="11"
                                        Margin="5,0"
                                        Cursor="Hand"/>
                                <Button Content="Удалить" 
                                        Background="#E74C3C" 
                                        Foreground="White" 
                                        Padding="10,5" 
                                        FontSize="11"
                                        Margin="5,0"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
