<Page x:Class="HabitTracker1.Views.HabitsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:HabitTracker1.Converters"
      Title="Мои привычки"
      Background="#F5F5F5">
    <Page.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопка добавления привычки -->
        <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Добавить привычку" 
                        Background="#27AE60" 
                        Foreground="White" 
                        Padding="15,10" 
                        FontSize="12" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="AddHabitButton_Click"/>
                <Button Content="Обновить" 
                        Background="#3498DB" 
                        Foreground="White" 
                        Padding="15,10" 
                        FontSize="12" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="10,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Список привычек -->
        <ListBox Grid.Row="1" 
                 x:Name="HabitsListBox"
                 Background="#F5F5F5"
                 BorderThickness="0"
                 ItemsSource="{Binding Habits}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" 
                            Margin="10" 
                            Padding="15" 
                            CornerRadius="5"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Название привычки -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding Title}" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"/>

                            <!-- Описание -->
                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Text="{Binding Description}" 
                                       FontSize="12"
                                       Foreground="#95A5A6"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>

                            <!-- Категория -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="{Binding Category.Name, StringFormat='Категория: {0}'}" 
                                       FontSize="12"
                                       Foreground="#7F8C8D"
                                       Margin="0,5,0,0"/>

                            <!-- Частота и дополнительная информация -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding Frequency, StringFormat='Частота: {0}'}" 
                                           FontSize="12"
                                           Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding Unit, StringFormat=' | Единица: {0}'}" 
                                           FontSize="12"
                                           Foreground="#7F8C8D"
                                           Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Целевое значение -->
                            <TextBlock Grid.Row="4" Grid.Column="0" 
                                       Text="{Binding TargetValue, StringFormat='Целевое значение: {0}'}" 
                                       FontSize="12"
                                       Foreground="#7F8C8D"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding TargetValue, Converter={StaticResource NullToVisibilityConverter}}"/>

                            <!-- Кнопки -->
                            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="5" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Отметить" 
                                        Background="#27AE60" 
                                        Foreground="White" 
                                        Padding="10,5" 
                                        FontSize="11"
                                        Margin="10,0"
                                        Cursor="Hand"
                                        Click="MarkHabitButton_Click"/>
                                <Button Content="Изменить" 
                                        Background="#3498DB" 
                                        Foreground="White" 
                                        Padding="10,5" 
                                        FontSize="11"
                                        Margin="5,0"
                                        Cursor="Hand"
                                        Click="EditHabitButton_Click"/>
                                <Button Content="Удалить" 
                                        Background="#E74C3C" 
                                        Foreground="White" 
                                        Padding="10,5" 
                                        FontSize="11"
                                        Margin="5,0"
                                        Cursor="Hand"
                                        Click="DeleteHabitButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
