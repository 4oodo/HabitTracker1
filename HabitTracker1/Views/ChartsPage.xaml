<Page x:Class="HabitTracker1.Views.ChartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Графики"
      Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="350"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Графики и статистика" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <!-- Выбор периода -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Период:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="PeriodComboBox" Width="200" SelectedIndex="0" SelectionChanged="PeriodComboBox_SelectionChanged">
                <ComboBoxItem Tag="7">Неделя</ComboBoxItem>
                <ComboBoxItem Tag="30">Месяц</ComboBoxItem>
                <ComboBoxItem Tag="90">3 месяца</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- Столбчатая диаграмма - Прогресс привычек (левая верхняя) -->
        <Border Grid.Row="2" Grid.Column="0" 
                Background="White" 
                Margin="0,0,10,10" 
                Padding="20" 
                CornerRadius="5"
                BorderBrush="#BDC3C7"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Прогресс привычек (%)" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,20"/>
                <Canvas x:Name="HabitProgressChart" Background="#ECF0F1" Height="300"/>
            </StackPanel>
        </Border>

        <!-- Круговая диаграмма - Распределение по категориям (правая верхняя) -->
        <Border Grid.Row="2" Grid.Column="1" 
                Background="White" 
                Margin="10,0,0,10" 
                Padding="20" 
                CornerRadius="5"
                BorderBrush="#BDC3C7"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Успешность по категориям" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,20"/>
                <Canvas x:Name="CategoryChart" Background="#ECF0F1" Height="300"/>
            </StackPanel>
        </Border>

        <!-- Тепловая карта (полная ширина снизу) -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" 
                Background="White" 
                Margin="0,10,0,0" 
                Padding="20" 
                CornerRadius="5"
                BorderBrush="#BDC3C7"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Активность по дням (тепловая карта)" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,20"/>
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Height="200">
                    <ItemsControl x:Name="HeatmapGrid" Background="#ECF0F1" Padding="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
