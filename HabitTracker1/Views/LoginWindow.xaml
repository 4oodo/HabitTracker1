<Window x:Class="HabitTracker1.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в Habit Tracker" 
        Height="542" 
        Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border CornerRadius="10" Background="White" BorderBrush="#2C3E50" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8,8,0,0">
                <TextBlock Text="Habit Tracker" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Содержимое -->
            <StackPanel Grid.Row="1" Margin="30,40" VerticalAlignment="Top">
                <TextBlock Text="Вход в систему" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Margin="0,0,0,30"
                           Foreground="#2C3E50"/>

                <!-- Имя пользователя -->
                <TextBlock Text="Имя пользователя:" 
                           Margin="0,0,0,8"
                           Foreground="#34495E"/>
                <TextBox x:Name="UsernameTextBox" 
                         Padding="10"
                         Height="35"
                         Margin="0,0,0,15"
                         FontSize="12"
                         Background="#ECF0F1"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль:" 
                           Margin="0,0,0,8"
                           Foreground="#34495E"/>
                <PasswordBox x:Name="PasswordBox" 
                             Padding="10"
                             Height="35"
                             Margin="0,0,0,10"
                             FontSize="12"
                             Background="#ECF0F1"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"/>

                <!-- Сообщение об ошибке -->
                <TextBlock x:Name="ErrorMessage" 
                           Foreground="#E74C3C" 
                           Margin="0,0,0,15"
                           TextWrapping="Wrap"
                           MinHeight="20"/>

                <!-- Кнопки -->
                <Button x:Name="LoginButton" 
                        Content="Вход" 
                        Height="40" 
                        Background="#27AE60" 
                        Foreground="White" 
                        FontSize="14" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="LoginButton_Click"
                        Margin="0,0,0,10"/>

                <Button x:Name="RegisterButton" 
                        Content="Создать аккаунт" 
                        Height="40" 
                        Background="#3498DB" 
                        Foreground="White" 
                        FontSize="14" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="RegisterButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
