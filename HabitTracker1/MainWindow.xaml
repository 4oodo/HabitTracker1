<Window x:Class="HabitTracker1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabitTracker1"
        mc:Ignorable="d"
        Title="Habit Tracker" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECF0F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхнее меню -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Habit Tracker" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Margin="0,0,30,0"/>
                <TextBlock x:Name="UserGreeting" 
                           Foreground="White" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,0,30,0"/>
                <Button Content="Выход"
                        Background="#E74C3C" 
                        Foreground="White" 
                        Padding="10,5" 
                        Margin="20,0,0,0"
                        Click="LogoutButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Содержимое -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель (Меню) -->
            <Border Grid.Column="0" Background="White" BorderBrush="#BDC3C7" BorderThickness="0,0,1,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Меню" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Button Content="Мои привычки" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="HabitsButton_Click"
                            Tag="Habits"/>

                    <Button Content="Статистика" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="StatisticsButton_Click"
                            Tag="Statistics"/>

                    <Button Content="Категории" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="CategoriesButton_Click"
                            Tag="Categories"/>

                    <Button Content="Графики" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="ChartsButton_Click"
                            Tag="Charts"/>

                    <Button Content="Параметры" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="SettingsButton_Click"
                            Tag="Settings"/>
                </StackPanel>
            </Border>

            <!-- Содержимое страницы -->
            <Frame Grid.Column="1" 
                   x:Name="ContentFrame" 
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
